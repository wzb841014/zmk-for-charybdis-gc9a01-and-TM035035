#include "charybdis.dtsi"
/* config/boards/arm/pinnacle_100/pinnacle_100.dts */
#include <nordic/nrf52840_qiaa.dtsi>



/* 
 * I2C 总线配置 (假设 IC27 触摸芯片连接在 I2C0)
 * 请根据实际原理图修改 SDA/SCL 引脚
 */
&i2c0 {
    status = "okay";
    clock-frequency = <400000>; /* 400kHz */
    
    /* 
     * IC27 电容触摸传感器节点 
     * 标签名: ic27_touch (这就是你在 overlay 中要引用的名字)
     */
    ic27_touch: touch@27 {
        compatible = "semtech,sx1280"; /* 注意：请替换为实际的驱动兼容字符串，例如 "onsemi,ncs2200" 或 "zmk,cap-sensor" */
        reg = <0x27>;                  /* I2C 地址 0x27 */
        status = "disabled";           /* 默认禁用，由 Shield Overlay 启用 */
        
        /* 中断引脚配置 (请根据原理图修改 GPIO 端口和引脚号) */
        interrupt-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        
        /* 其他可能的属性，取决于具体驱动 */
        // zmk,read-delay-ms = <5>;
    };
};

/* 
 * SPI 总线配置 (如果你还有 GC9A01A 屏幕，通常也在 SPI 上)
 * 假设屏幕连接在 SPI0
 */
&spi0 {
    status = "okay";
};




&adc {
    status = "okay";
    // ... ADC 通道配置 ...
};
*/


&default_transform {
    col-offset = <6>;
};

&kscan0 {
	col-gpios
		= <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};




&ic27_touch {
    status = "okay";
};
