#include "charybdis_right.dtsi"
#include "charybdis.dtsi"
/ {
    chosen {
        zephyr,display = &gc9a01;
    };
};       



/ {
    /* SPI 引脚配置 */
    spi0_default: spi0_default {
        sck {
            nrf-pinctrl-single = <8>;
        };
        mosi {
            nrf-pinctrl-single = <17>;
        };
        miso {
            nrf-pinctrl-single = <17>;
        };
    };

    /* GC9A01 显示屏定义 */
    gc9a01: gc9a01 {
        compatible = "zmk,gc9a01a";
        label = "GC9A01";
        spi-dev = <&spi0>;
        power-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW)>;
        dc-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH)>;
        cs-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW)>;
        bl-gpios = <&gpio1 2  (GPIO_ACTIVE_HIGH)>;  // ← 加这行，改成你实际的引脚
        width = <240>;
        height = <240>;
        rotation = <0>;
        x-offset = <0>;
        y-offset = <0>;
    };
};

&spi0 {
    status = "okay";
    
    /* 旧式引脚配置 (必需) */
    sck-pin = <8>;    
    mosi-pin = <17>;   
    miso-pin = <17>;   
    
    /* pinctrl 配置 (可选，如果支持) */
    /* pinctrl-0 = <&spi0_default>; */
    /* pinctrl-names = "default"; */
};

&adc {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};



&kscan0 {
    status = "okay";

};
